!Configuração da WAN do Router 4321
enable
    configure terminal
        interface gigabitEthernet 0/0/0
            media-type sfp 
            description Interface WAN com router 1941
            ip address 10.0.0.2 255.255.255.252
            no shutdown
            end
write 
---------------------------------------------------------------------
!Configuração da WAN do Router 1941
enable
    configure terminal
        interface gigabitEthernet 0/0/0
            media-type sfp 
            description Interface WAN com router 4321
            ip address 10.0.0.1 255.255.255.252
            no shutdown
            end
write 
-------------------------------------------------------------------
!configuraçao da rota Estatica do Router 1941
enable
    configure terminal
    !Rota padrão
        ip route 0.0.0.0  0.0.0.0 10.0.0.2 (todas as redes menos as redes que ele conhece)
        end
write
show ip route
---------------------------------------------------------------------
!Configuração do Switch Multilayer 3650
enable
    configure terminal 
        ip route 0.0.0.0 0.0.0.0 172.16.0.30
        end
write
show ip route 
-----------------------------------------------------------------------
!Configuração do Router 4321
enable 
    configure terminal
        ip route 0.0.0.0 0.0.0.0 172.16.0.29
        ip route 192.168.1.0 255.255.255.0 10.0.0.1
        end
write
tracert
